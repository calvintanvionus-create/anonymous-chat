# 複製這個檔案成 .env.local 再填值。.env.local 不會被 commit。
# 這個檔案只放假值，可以 commit。

# 階段一用 mock（假資料、不連 Supabase）；階段二改成 supabase
VITE_BACKEND=mock

# 階段二才需要。只放「公開金鑰」，絕對不要放 secret key / service_role key / 資料庫密碼
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
